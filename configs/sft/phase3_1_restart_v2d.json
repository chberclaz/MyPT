{
  "name": "Phase 3.1 restart v2d: abstention eval-mirror",
  "description": "v2c suite still abstention 0/2. Eval-aligned abstention (ONLY context + scorer phrases). Init from phase3_1_restart_v2c_gold.",
  "batch_size": 4,
  "block_size": 4096,
  "vocab_size": 50304,
  "n_embd": 1280,
  "n_head": 20,
  "n_layer": 32,
  "dropout": 0.12,
  "bias": false,
  "tie_weights": true,
  "pos_encoding": "rope",
  "mlp_type": "swiglu",
  "norm_type": "rmsnorm",
  "use_checkpoint": true,
  "rope_theta": 10000.0,
  "rope_scale": 4.0,
  "learning_rate": 5e-06,
  "max_iters": 80,
  "eval_interval": 20,
  "save_every": 20,
  "warmup_iters": 16,
  "use_amp": true,
  "amp_dtype": "bf16",
  "grad_accum_steps": 3,
  "use_loss_mask": true,
  "batch_sampling_mode": "epoch",
  "pad_token_id": null,
  "episode_min_tokens": 10,
  "epoch_seed": 3371,
  "epoch_shuffle": true,
  "epoch_drop_last": true,
  "weight_decay": 0.05,
  "eval_sets": {
    "phase1_format": "data/sft_phase1_format_lock_chat",
    "phase2_operators": "data/sft_phase2_operators_chat",
    "phase2_remix_existing": "data/sft_phase3_eval_phase2_remix_chat"
  },
  "eval_seed": 1337,
  "log_file": "logs/train/phase3_1_restart_v2d.jsonl",
  "token_accuracy_saturation": {
    "enabled": true,
    "window": 4,
    "min_steps_before_check": 60,
    "min_delta": 0.002,
    "gap_growth_threshold": 0.01,
    "action": "log_and_flag"
  }
}
